PortSystem          1.0

name                desktop-2fa
version             0.7.2
categories          security python
platforms           darwin
license             Apache-2.0
maintainers         {lukaszperek @wrogistefan} openmaintainer
description         Secure offline TOTP 2FA generator with encrypted vault
long_description    ${description}
homepage            https://github.com/wrogistefan/desktop-2fa


master_sites        https://files.pythonhosted.org/packages/py3/d/desktop_2fa/
distname            desktop_2fa-${version}-py3-none-any
distfiles           ${distname}.whl

# Wstaw tu SHA256 wheel'a
checksums           sha256 009C605476CD656EF9FD14A21CD2E61E1932881BD76458DF6A3161FCE95E9702


depends_run         port:python312 \
                    port:pipx

build {}

destroot {
    # Instalacja przez pipx (tak jak w Homebrew)
    system "pipx install desktop-2fa==${version}"

    # Wrapper d2fa
    xinstall -m 755 ${filespath}/d2fa.sh ${destroot}${prefix}/bin/d2fa
}

livecheck.type      pypi

